PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skinwise_ai
DB_USER=skinwise_app
DB_PASSWORD=replace_with_a_local_database_password
SESSION_SECRET=replace_with_at_least_32_random_bytes
OTP_HASH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
YOUCAM_API_KEY=replace_with_your_server_side_youcam_api_key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM="SkinWise AI <no-reply@example.com>"
RECOVERY_IP_LIMIT=8
RECOVERY_IP_WINDOW_MS=900000
RECOVERY_EMAIL_LIMIT=5
RECOVERY_EMAIL_WINDOW_MS=3600000
RECOVERY_RESEND_COOLDOWN_MS=60000
RECOVERY_OTP_MAX_ATTEMPTS=5
REDIS_URL=redis_URL
